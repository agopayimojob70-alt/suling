{"id":1,"name":"开场白","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":231,"indent":0,"parameters":[1,"1",0,0,0,0,140,120,255,0]},{"code":224,"indent":0,"parameters":[[255,255,255,255],60,false]},{"code":121,"indent":0,"parameters":[10,10,0]},{"code":225,"indent":0,"parameters":[5,5,60,false]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["梦"]},{"code":401,"indent":0,"parameters":["意识回笼时还带着些许眩晕。"]},{"code":401,"indent":0,"parameters":["在黑暗始中，率先传来的是指尖一片冰凉，"]},{"code":401,"indent":0,"parameters":["四周是堆叠的金属残骸"]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["最令注意的是眼前一颗巨树。"]},{"code":401,"indent":0,"parameters":["说是树，更像是某种金属造物。"]},{"code":401,"indent":0,"parameters":["树干上透出流光，繁茂的叶片上同样流动"]},{"code":401,"indent":0,"parameters":["着点点光辉，部分树枝像枯藤般垂落"]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[2,"2",0,0,0,0,140,120,255,0]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["上面还沾着干涸的、深褐色的痕迹。"]},{"code":401,"indent":0,"parameters":["空气中弥漫着灰尘和一种刺鼻气味，远处"]},{"code":401,"indent":0,"parameters":["似乎又电流滋滋作响，混杂着断断续续类"]},{"code":401,"indent":0,"parameters":["似老式电视的杂音。"]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["“这是...哪里？”"]},{"code":401,"indent":0,"parameters":["我低声自语，声音在空旷的空间里显得格"]},{"code":401,"indent":0,"parameters":["外突兀。"]},{"code":401,"indent":0,"parameters":["视线扫过布满裂痕的屏幕"]},{"code":225,"indent":0,"parameters":[5,5,60,false]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["上面残留着扭曲的模糊影像。"]},{"code":401,"indent":0,"parameters":["明明记得自己之前在...在哪? 脑中仿佛被"]},{"code":401,"indent":0,"parameters":["针扎般疼痛。"]},{"code":401,"indent":0,"parameters":["我试着向前，却发现双腿仿佛灌了铅"]},{"code":225,"indent":0,"parameters":[5,5,60,false]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["只能在几步范围内行动，再往前一步，就像"]},{"code":401,"indent":0,"parameters":["撞上无形的屏障，一股微弱阻力将我推回。"]},{"code":401,"indent":0,"parameters":["突然一股颤栗涌起，背后传来一声极轻的"]},{"code":401,"indent":0,"parameters":["响动，不是金属摩擦，更像是..."]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[3,"3",0,0,0,0,140,120,255,0]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["凭空出现了呼吸声。"]},{"code":401,"indent":0,"parameters":["我猛地回头。"]},{"code":401,"indent":0,"parameters":["昏暗中，几步远的地方站着一个身影。轮廓"]},{"code":401,"indent":0,"parameters":["很模糊，像是被一层雾气笼罩"]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["可奇怪的是，我感受不到丝毫恐惧，反而有"]},{"code":401,"indent":0,"parameters":["种莫名的熟悉，像是见过无数次一样。"]},{"code":401,"indent":0,"parameters":["是谁？"]},{"code":401,"indent":0,"parameters":["我下意识朝人影迈出——步"]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["那道无形的屏障消失了。"]},{"code":401,"indent":0,"parameters":["我又往前几步，人影依旧静静站着。直到只"]},{"code":401,"indent":0,"parameters":["剩一步距离，我甚至能感觉到对方身上传来"]},{"code":401,"indent":0,"parameters":["的寒意。"]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["“你...”我刚要开口，人影突然扭曲了下。"]},{"code":401,"indent":0,"parameters":["一道声音从雾气传出，模糊的像是隔着厚重"]},{"code":401,"indent":0,"parameters":["的玻璃。我屏住呼吸，勉强捕捉到几个破碎"]},{"code":401,"indent":0,"parameters":["的音节。"]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["“...找...”"]},{"code":401,"indent":0,"parameters":["“找到...”"]},{"code":401,"indent":0,"parameters":["“...它...”"]},{"code":401,"indent":0,"parameters":["最后一字消散在空气里"]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["人影轮廓突然开始变得更加透明。"]},{"code":401,"indent":0,"parameters":["电流声和杂音越来越响。"]},{"code":401,"indent":0,"parameters":["我脑海中反复播放着那模糊的音节。"]},{"code":401,"indent":0,"parameters":["找到什么？他还是她？这是哪里？"]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[4,"4",0,0,0,0,140,120,255,0]},{"code":224,"indent":0,"parameters":[[255,255,255,255],60,false]},{"code":225,"indent":0,"parameters":[9,9,60,false]},{"code":101,"indent":0,"parameters":["00",0,0,2]},{"code":401,"indent":0,"parameters":["那个身影又是谁？"]},{"code":401,"indent":0,"parameters":["头越来越晕，周围景象开始剧烈扭曲，身旁"]},{"code":401,"indent":0,"parameters":["树的光亮骤然刺眼，杂音变成尖锐的蜂鸣——"]},{"code":401,"indent":0,"parameters":["我又陷入黑暗....."]},{"code":201,"indent":0,"parameters":[0,5,10,7,0,0]},{"code":121,"indent":0,"parameters":[10,10,1]},{"code":123,"indent":0,"parameters":["A",0]},{"code":235,"indent":0,"parameters":[4]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":7,"y":6},
