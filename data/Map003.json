{"id":3,"name":"EV003","note":"<glow>","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":250,"indent":0,"parameters":[{"name":"Book1","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["「第一天：我又来了。我不记得上一次发生了什么，"]},{"code":401,"indent":0,"parameters":["但我记得「来过」这件事本身。这就够了。」"]},{"code":401,"indent":0,"parameters":["「第二天：酒馆莉亚的杯子，杯柄朝左。我故意把它"]},{"code":401,"indent":0,"parameters":["朝右转了一点。明天来看会不会变回去。」"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["「第三天：变回去了。不是她转的，是这个世界。」"]},{"code":401,"indent":0,"parameters":["「第五天：铁匠格鲁的剑，崩口的位置和上次一模一样。"]},{"code":401,"indent":0,"parameters":["这说明什么？说明「上次」确实存在。不是我的错觉。」"]},{"code":401,"indent":0,"parameters":["「第七天：我找到了禁地。看到了那些水晶。看到了"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["「自己」。我明白了。我不是精灵王国的居民。」"]},{"code":401,"indent":0,"parameters":["「第十天：我要留下一些东西。这个世界可以清除"]},{"code":401,"indent":0,"parameters":["我的记忆，但清除不了物理存在。只要我把线索刻在"]},{"code":401,"indent":0,"parameters":["石头上、写在纸上、藏在世界的缝隙里——总有一天，"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["某一个「我」会集齐所有碎片。」"]},{"code":401,"indent":0,"parameters":["「第十三天：世界之力发现我了。它在「收束」"]},{"code":401,"indent":0,"parameters":["我的存在。我开始忘记自己写了什么。我甚至忘记了"]},{"code":401,"indent":0,"parameters":["自己为什么要写。但我还在写。手在写，脑子不记得。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["这感觉很奇怪。」"]},{"code":401,"indent":0,"parameters":["「第十五天：……」"]},{"code":401,"indent":0,"parameters":["后面的压痕越来越浅，越来越乱，最后几页几乎看不出"]},{"code":401,"indent":0,"parameters":["字形，只有无意义的划痕。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["最后一页，只有一句话——用力极重，几乎划破了纸面："]},{"code":401,"indent":0,"parameters":["「不要相信结局。」"]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":false},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":126,"indent":0,"parameters":[18,0,0,1]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["成功"]},{"code":401,"indent":0,"parameters":["获取重要线索"]},{"code":123,"indent":0,"parameters":["B",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"B","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":7,"y":4},
